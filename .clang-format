BasedOnStyle: LLVM
AlwaysBreakTemplateDeclarations: Yes
CommentPragmas: '^ (IWYU pragma:|SPDX-)'
IncludeCategories:
  - Regex:           '^<'
    Priority:        4
  - Regex:           '^"(llvm|llvm-c|clang|clang-c|mlir|mlir-c)/'
    Priority:        3
  - Regex:           '^"(cudaq-pulse|\.\.)/'
    Priority:        2
  - Regex:           '.*'
    Priority:        1
