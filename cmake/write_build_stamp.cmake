# Writes OUTPUT, a C++ file defining cudaqPulseBuildStamp: the first 16 hex
# digits of a SHA-256 of LLVM_VERSION and the contents of the files listed in
# SOURCES, one per line. A pickled program records it, and only an extension
# with the same stamp unpickles it. OUTPUT is rewritten only when the stamp
# changes, so that an unchanged stamp relinks nothing.
#
#   cmake -DSOURCES=<list file> -DLLVM_VERSION=<version> -DOUTPUT=<file.cpp>
#         -P write_build_stamp.cmake

file(STRINGS "${SOURCES}" _sources)
set(_digests "${LLVM_VERSION}")
foreach(_source IN LISTS _sources)
  file(SHA256 "${_source}" _digest)
  string(APPEND _digests " ${_digest}")
endforeach()
string(SHA256 _stamp "${_digests}")
string(SUBSTRING "${_stamp}" 0 16 _stamp)
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT
  "// Generated by cmake/write_build_stamp.cmake.\nextern const char *const cudaqPulseBuildStamp;\nconst char *const cudaqPulseBuildStamp = \"@_stamp@\";\n"
  @ONLY)
