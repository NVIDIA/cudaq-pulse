# Writes OUTPUT, the dialect source of the checkout ROOT built with
# LLVM_VERSION: what a bytecode module states of the Pulse and Classical
# dialects it was written with, and what pulse.load holds it to. MLIR
# bytecode holds an operation's properties by position, in the shape of the
# writer's copy of the dialect, so it is read only with the source that
# wrote it.
#
# The source is "<LLVM_VERSION>-<digest>". The digest is the first 16 hex
# digits of a SHA-256 of one line per definition file of the two dialects,
# "<path> <SHA-256 of its contents>\n": the .td, .h and .cpp files under
#   core/mlir/include/cudaq-pulse/Dialect/Pulse/
#   core/mlir/include/cudaq-pulse/Dialect/Classical/
#   core/mlir/dialects/Pulse/
#   core/mlir/dialects/Classical/
# with paths relative to ROOT, in byte order, and the files' bytes as they
# are checked in (line endings included). It changes with those files and
# with the LLVM version, and with nothing else of the checkout. LLVM_VERSION
# is the writer's own, in full; pulse.load compares the digest and the
# version's major and minor, so that patch releases of one LLVM minor read
# each other's bytecode.
#
# OUTPUT named *.py is the package's _dialect_source.py; any other name gets
# the source as a C++ string literal, for a writer to state in its bytecode:
#   mlir::BytecodeWriterConfig config("<tool> cudaq-pulse-dialects="
#   #include "dialect_source.inc"
#   );
# OUTPUT is rewritten only when it changes.
#
#   cmake -DROOT=<checkout> -DLLVM_VERSION=<version> -DOUTPUT=<file>
#         -P write_dialect_source.cmake

# A folder that is a symbolic link is not followed, under every CMake.
cmake_policy(SET CMP0009 NEW)

# The source is read as a version that starts with a major and a minor.
if(NOT LLVM_VERSION MATCHES "^[0-9]+\\.[0-9]+(\\.|$)")
  message(FATAL_ERROR
    "LLVM_VERSION is '${LLVM_VERSION}', not a version such as 22.1.8")
endif()

set(_patterns "")
foreach(_folder IN ITEMS include/cudaq-pulse/Dialect dialects)
  foreach(_dialect IN ITEMS Pulse Classical)
    foreach(_kind IN ITEMS td h cpp)
      list(APPEND _patterns "${ROOT}/core/mlir/${_folder}/${_dialect}/*.${_kind}")
    endforeach()
  endforeach()
endforeach()
file(GLOB_RECURSE _files RELATIVE "${ROOT}" ${_patterns})
if(NOT _files)
  message(FATAL_ERROR "no dialect definition files under ${ROOT}/core/mlir")
endif()
list(SORT _files COMPARE STRING CASE SENSITIVE)
set(_lines "")
foreach(_file IN LISTS _files)
  file(SHA256 "${ROOT}/${_file}" _digest)
  string(APPEND _lines "${_file} ${_digest}\n")
endforeach()
string(SHA256 _digest "${_lines}")
string(SUBSTRING "${_digest}" 0 16 _digest)
set(_source "${LLVM_VERSION}-${_digest}")
if(OUTPUT MATCHES "\\.py$")
  file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT
    "# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
\"\"\"The source of this build's Pulse and Classical dialects (generated by
cmake/write_dialect_source.cmake).\"\"\"

DIALECT_SOURCE = \"@_source@\"
"
    @ONLY)
else()
  file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT
    "// Generated by cmake/write_dialect_source.cmake.\n\"@_source@\"\n" @ONLY)
endif()
