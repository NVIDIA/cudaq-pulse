# Writes OUTPUT, the package's _source_stamp.py:
#   SOURCE_STAMP, the first 16 hex digits of a SHA-256 of the path and contents
#     of each file listed in SOURCES (paths relative to ROOT, one per line);
#     a pickled program records it, and only the same sources unpickle it.
#   CALIBRATIONS, the first 16 hex digits of the SHA-256 of each shipped
#     calibration file, by name: what tells a shipped calibration apart
#     without hashing its contents at run time.
# OUTPUT is rewritten only when it changes.
#
#   cmake -DROOT=<package dir> -DSOURCES=<list file> -DOUTPUT=<file.py>
#         -P write_source_stamp.cmake

file(STRINGS "${SOURCES}" _sources)
set(_digests "")
set(_calibrations "")
foreach(_source IN LISTS _sources)
  file(SHA256 "${ROOT}/${_source}" _digest)
  string(APPEND _digests " ${_source} ${_digest}")
  if(_source MATCHES "^targets/calibrations/([A-Za-z0-9_]+)\\.json$")
    string(SUBSTRING "${_digest}" 0 16 _digest)
    string(APPEND _calibrations "\n    \"${CMAKE_MATCH_1}\": \"${_digest}\",")
  endif()
endforeach()
string(SHA256 _stamp "${_digests}")
string(SUBSTRING "${_stamp}" 0 16 _stamp)
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT
  "\"\"\"What this build's Python sources are (generated by cmake/write_source_stamp.cmake).\"\"\"

SOURCE_STAMP = \"@_stamp@\"
CALIBRATIONS: dict[str, str] = {@_calibrations@
}
"
  @ONLY)
